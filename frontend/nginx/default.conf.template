# Interface React + encaminhamento da API no mesmo endereço.
# API_UPSTREAM é substituído na inicialização do container (envsubst da imagem oficial do Nginx).
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # /todos e /todos/:id vão para a API preservando método e caminho
    location /todos {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Saúde da API (inclui a conexão com o banco)
    location = /health {
        proxy_pass ${API_UPSTREAM};
    }

    location / {
        try_files $uri /index.html;
    }
}
