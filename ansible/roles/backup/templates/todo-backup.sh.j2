#!/usr/bin/env bash
# {{ ansible_managed }}
# Backup do banco todo-app: cópia local + cópia no S3 ({{ backup_bucket }}/{{ backup_prefix }}).
set -euo pipefail

STAMP=$(date -u +%Y%m%dT%H%M%SZ)
NAME="todo-app-${STAMP}.archive.gz"
FILE="{{ backup_dir }}/${NAME}"

# Credenciais usadas só dentro do contêiner (variáveis de ambiente dele), nada aparece no log
docker exec {{ mongo_container }} sh -c \
  'mongodump --quiet -u "$MONGO_INITDB_ROOT_USERNAME" -p "$MONGO_INITDB_ROOT_PASSWORD" --authenticationDatabase admin --db todo-app --archive --gzip' \
  > "${FILE}"

# Envio ao S3 com as permissões da VM (instance profile), sem chaves gravadas na máquina
docker run --rm --network host -v "{{ backup_dir }}:/backup:ro" {{ awscli_image }} \
  s3 cp "/backup/${NAME}" "s3://{{ backup_bucket }}/{{ backup_prefix }}${NAME}" \
  --region {{ aws_region }} --only-show-errors

# Retenção local; no S3 a retenção é feita pela regra de ciclo de vida do bucket
find "{{ backup_dir }}" -name 'todo-app-*.archive.gz' -mtime +{{ backup_keep_days }} -delete

echo "$(date -u +%FT%TZ) backup OK: ${NAME} ($(stat -c %s "${FILE}") bytes) -> s3://{{ backup_bucket }}/{{ backup_prefix }}${NAME}"
